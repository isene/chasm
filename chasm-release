#!/bin/bash
# Build the locked core desktop. --stage DIR prepares a bundle without publishing.
set -euo pipefail

HERE=$(cd "$(dirname "$0")" && pwd)
ROOT=$(dirname "$HERE")
STAGE=""
while [ $# -gt 0 ]; do
    case $1 in
        --stage|--root)
            [ $# -ge 2 ] || { echo "chasm-release: $1 needs a directory" >&2; exit 2; }
            if [ "$1" = --stage ]; then STAGE=$2; else ROOT=$2; fi
            shift 2 ;;
        *) echo "chasm-release: unknown option $1" >&2; exit 2 ;;
    esac
done

REPOS=(frame tile glass bare show chasm-bits bolt spot)
SOURCES=("${REPOS[@]}" glyph)
declare -A LOCK
while read -r repo sha extra; do
    [[ -z $repo || $repo == \#* ]] && continue
    [[ $sha =~ ^[0-9a-f]{40}$ && -z ${extra:-} && -z ${LOCK[$repo]+x} ]] || {
        echo "chasm-release: invalid sources.lock entry: $repo" >&2; exit 1;
    }
    LOCK[$repo]=$sha
done < "$HERE/sources.lock"
[ "${#LOCK[@]}" -eq "${#SOURCES[@]}" ] || { echo "chasm-release: incomplete sources.lock" >&2; exit 1; }
for repo in "${SOURCES[@]}"; do
    [ -n "${LOCK[$repo]:-}" ] || { echo "chasm-release: missing $repo pin" >&2; exit 1; }
done

PUBLISH=0
if [ -z "$STAGE" ]; then
    TMP=$(mktemp -d)
    trap 'rm -rf "$TMP"' EXIT
    STAGE=$TMP/chasm
    PUBLISH=1
fi
[ ! -e "$STAGE" ] || [ -z "$(ls -A "$STAGE")" ] || {
    echo "chasm-release: stage directory is not empty: $STAGE" >&2; exit 1;
}

for repo in "${SOURCES[@]}"; do
    src=$ROOT/$repo
    [ -d "$src/.git" ] || { echo "chasm-release: missing checkout $src" >&2; exit 1; }
    [ "$(git -C "$src" rev-parse HEAD)" = "${LOCK[$repo]}" ] || {
        echo "chasm-release: $repo is not at its locked commit" >&2; exit 1;
    }
    [ -z "$(git -C "$src" status --porcelain)" ] || {
        echo "chasm-release: $repo checkout is dirty" >&2; exit 1;
    }
done

mkdir -p "$STAGE/bin" "$STAGE/lib/systemd" "$STAGE/share/bare/plugins" \
    "$STAGE/share/xcursors/default/cursors"
for repo in "${REPOS[@]}"; do make -s -C "$ROOT/$repo" >/dev/null; done
put(){ install -m755 "$1" "$STAGE/bin/$2"; }
put "$ROOT/frame/frame"            frame
put "$ROOT/tile/tile"              tile
put "$ROOT/tile/strip"             tile-strip
put "$ROOT/glass/glass"            glass
put "$ROOT/bare/bare"              bare
put "$ROOT/bare/bare-open"         bare-open
put "$ROOT/show/show"              show
put "$ROOT/spot/spot"              spot
put "$ROOT/bolt/bolt"              bolt
put "$ROOT/bolt/bolt-auth"         bolt-auth
put "$ROOT/bolt/bolt-greet"        bolt-greet
put "$ROOT/bolt/greet-session"     greet-session
put "$ROOT/bolt/bolt-greet-run"    bolt-greet-run
put "$ROOT/bolt/bolt-greet-auth.example" bolt-greet-auth.example
put "$ROOT/bolt/chasm-bg"          chasm-bg
programs=$(sed -n 's/^PROGRAMS *= *//p' "$ROOT/chasm-bits/Makefile")
[ -n "$programs" ] || { echo 'chasm-release: no chasm-bits programs found' >&2; exit 1; }
for p in $programs; do
    put "$ROOT/chasm-bits/$p" "bits-$p"
done
put "$HERE/chasm-keys"     chasm-keys
put "$HERE/chasm-session"  chasm-session
put "$HERE/chasm-wp"       chasm-wp
install -m644 "$ROOT/bolt/bolt-greet.service" "$STAGE/lib/systemd/"
install -m755 "$ROOT/bare/plugins/ask" "$ROOT/bare/plugins/suggest" "$STAGE/share/bare/plugins/"
install -m644 "$HERE/assets/xcursors/default/index.theme" "$STAGE/share/xcursors/default/index.theme"
base64 -d "$HERE/assets/xcursors/default/cursors/hand.b64" > "$STAGE/share/xcursors/default/cursors/hand"
chmod 644 "$STAGE/share/xcursors/default/cursors/hand"

for repo in "${SOURCES[@]}"; do printf '%s %s\n' "$repo" "${LOCK[$repo]}"; done > "$STAGE/VERSIONS"
printf 'nasm %s\nld %s\ngcc %s\n' \
    "$(nasm -v)" "$(ld -v)" "$(gcc -dumpfullversion)" >> "$STAGE/VERSIONS"
echo "staged $(find "$STAGE/bin" -type f | wc -l) programs in $STAGE"
[ "$PUBLISH" = 1 ] || exit 0

[ -z "$(git -C "$HERE" status --porcelain)" ] || {
    echo "chasm-release: commit umbrella changes before publishing" >&2; exit 1;
}
HEAD=$(git -C "$HERE" rev-parse HEAD)
[ "$HEAD" = "$(git -C "$HERE" ls-remote origin refs/heads/master | cut -f1)" ] || {
    echo "chasm-release: push master before publishing" >&2; exit 1;
}
TAG=r$(date -u +%Y%m%d-%H%M%S)
if gh release view "$TAG" -R isene/chasm >/dev/null 2>&1; then
    echo "chasm-release: release $TAG already exists" >&2; exit 1
fi
tar --sort=name --mtime='@0' --owner=0 --group=0 --numeric-owner -czf "$TMP/chasm-amd64.tar.gz" -C "$TMP" chasm
(cd "$TMP" && sha256sum chasm-amd64.tar.gz > chasm-amd64.tar.gz.sha256)
gh release create "$TAG" "$TMP/chasm-amd64.tar.gz" "$TMP/chasm-amd64.tar.gz.sha256" \
    -R isene/chasm --target "$HEAD" --latest --title "CHasm $TAG" \
    --notes "Locked core desktop binaries. Source commits and tool versions are in VERSIONS."
echo "published $TAG"
