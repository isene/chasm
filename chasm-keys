#!/bin/bash
# chasm-keys: print every key combo the CHasm suite owns.
#
# The tile/spot section is parsed LIVE from ~/.tilerc (bind lines,
# grouped by the file's own `# === section ===` headers), so it never
# drifts from what is actually bound. The frame and glass sections are
# the suite's fixed realms, with ~/.framerc / ~/.glassrc overrides
# honoured where they exist.
#
# Realms:  Mod4        = the desktop (tile, frame, spot), safe keys
#          Mod4+Shift  = acts on a window / restarts something
#          Alt         = glass (everything unbound passes through as Meta)
#
# Every row carries two texts: the command behind the key and a short
# description of what it does. For a tile bind the description is the
# trailing `# comment` on its line in ~/.tilerc when there is one, else
# a plain-words rendering of the action. The terminal table prints the
# description.
#
# Bash builtins only (CHasm rule: no awk/sed/interpreter spawns).
#
# `chasm-keys --popup` prints the table as tagged lines for tile's
# Mod4+? key-reference popup: H<tab>group header, S<tab>sub-header,
# R<tab>combo<tab>command<tab>description, blank = spacer. Tile parses
# exactly this; Tab in the popup flips between the two texts.

popup=0
[[ ${1-} == --popup ]] && popup=1

# Style only when stdout is a terminal. Piped output (show, less,
# grep) gets plain text instead of raw escape codes.
if [[ -t 1 ]]; then
    B=$'\e[1m'; D=$'\e[2m'; R=$'\e[0m'
else
    B=""; D=""; R=""
fi

if (( popup )); then
    row() { printf 'R\t%s\t%s\t%s\n' "$1" "$2" "$3"; }
    hdr() { printf '\nH\t%s\n' "$1"; }
    sub() { printf 'S\t%s\n' "$1"; }      # no spacer: the popup packs tight
else
    row() { printf '  %-24s %s\n' "$1" "$3"; }
    hdr() { printf '\n%s%s%s\n' "$B" "$1" "$R"; }
    sub() { printf '\n  %s%s%s\n' "$D" "$1" "$R"; }
fi

# exec_desc <command line>: plain words for the programs tile spawns.
exec_desc() {
    local c=$1 first
    case $c in
        glass)                    printf 'new terminal' ;;
        glass\ --class*)          printf 'new terminal (%s)' "${c#glass --class }" ;;
        glass\ --\ *)             printf 'terminal running %s' "${c#glass -- }" ;;
        *bolt*)                   printf 'lock the screen' ;;
        *scrot*)                  printf 'screenshot' ;;
        *chasm-wp*|*wp-cycle*)    printf 'next wallpaper' ;;
        # rofi as a whole word: *rofi* also hit power-p"rofi"le-toggle
        rofi|rofi[[:space:]]*|*[[:space:]/\'\"]rofi|*[[:space:]/\'\"]rofi[[:space:]\'\"]*)
                                  printf 'launcher' ;;
        *set-mute*toggle*)        printf 'mute toggle' ;;
        *set-mute*\ 1)            printf 'mute' ;;
        *set-mute*\ 0)            printf 'unmute' ;;
        *set-volume*%-*)          printf 'volume down' ;;
        *set-volume*%+*)          printf 'volume up' ;;
        *brightnessctl*%-*)       printf 'brightness down' ;;
        *brightnessctl*+*)        printf 'brightness up' ;;
        *brightnessctl\ s\ *)     printf 'brightness %s' "${c##* }" ;;
        *dpms\ force\ off*)       printf 'screen off' ;;
        *xset\ s\ on*)            printf 'screen blanking on' ;;
        *xset\ s\ off*)           printf 'screen blanking off' ;;
        *rfkill\ unblock*)        printf 'bluetooth on' ;;
        *rfkill\ block*)          printf 'bluetooth off' ;;
        *spot\ draw*)             printf 'draw on the screen (spot)' ;;
        *spot\ highlight*)        printf 'highlight a region (spot)' ;;
        *spot\ ocr*)              printf 'grab text from the screen (spot)' ;;
        *spot*)                   printf 'spotlight (spot)' ;;
        *)  first=${c%%[[:space:]]*}
            case $first in sh|bash) first=${c#*exec }; first=${first%%[[:space:]]*} ;; esac
            printf 'run %s' "${first##*/}" ;;
    esac
}

# act_desc <action>: plain words for a tile action.
act_desc() {
    local a=$1 rest dir
    case $a in
        kill)                        printf 'close the window' ;;
        exit)                        printf 'exit tile' ;;
        gather)                      printf 'collect lost windows' ;;
        reload)                      printf 'reload ~/.tilerc' ;;
        restart)                     printf 'restart tile in place' ;;
        overview)                    printf 'window list popup' ;;
        keys)                        printf 'this key reference' ;;
        stash)                       printf 'hide the window (stash)' ;;
        unstash)                     printf 'bring back the last stashed window' ;;
        workspace\ next-populated)   printf 'next workspace in use' ;;
        workspace\ prev-populated)   printf 'previous workspace in use' ;;
        workspace\ back-and-forth)   printf 'back to the previous workspace' ;;
        workspace\ *)                printf 'go to workspace %s' "${a#workspace }" ;;
        move-to\ *)                  printf 'move the window to workspace %s' "${a#move-to }" ;;
        focus\ next-tab)             printf 'next tab' ;;
        focus\ prev-tab)             printf 'previous tab' ;;
        focus\ *)                    printf 'focus the window %s' "${a#focus }" ;;
        move-tab\ *)                 printf 'move the tab %s' "${a#move-tab }" ;;
        layout\ toggle)              printf 'cycle the layout' ;;
        layout\ *)                   printf 'layout: %s' "${a#layout }" ;;
        spawn-split\ *)
            rest=${a#spawn-split }; dir=${rest%%[[:space:]]*}; rest=${rest#"$dir"}
            rest=${rest#"${rest%%[![:space:]]*}"}
            case $dir in up) dir=above ;; down) dir=below ;; *) dir="to the $dir" ;; esac
            printf 'open %s %s' "$rest" "$dir" ;;
        exec-here\ *)                printf '%s, same directory' "$(exec_desc "${a#exec-here }")" ;;
        exec\ *)                     exec_desc "${a#exec }" ;;
        *)                           printf '%s' "$a" ;;
    esac
}

# ── tile + spot + utility rows: live from ~/.tilerc ─────────────────────
hdr "TILE + SPOT + UTILITY ROWS   ${D}(live from ~/.tilerc)${R}"

# Number runs fold into one row: Mod4+1 .. Mod4+0 bound to workspace
# 1 .. 10 print as "Mod4+1..0  go to workspace 1-10". A run is binds in a
# row with the same modifiers, a digit key, the same action (workspace or
# move-to) on consecutive numbers, and no comment of their own.
run_n=0
flush_run() {
    (( run_n )) || return 0
    if (( run_n == 1 )); then
        row "$run_combo" "$run_verb $run_a" "$(act_desc "$run_verb $run_a")"
    else
        row "$run_pre$run_k1..$run_k2" "$run_verb $run_a-$run_b" \
            "$(act_desc "$run_verb $run_a-$run_b")"
    fi
    run_n=0
}

pend=""
while IFS= read -r line; do
    case $line in
        '# === '*)
            s=${line#'# === '}
            pend=${s%% ===*}
            ;;
        bind\ *)
            rest=${line#bind }
            combo=${rest%%[[:space:]]*}
            act=${rest#"$combo"}
            act=${act#"${act%%[![:space:]]*}"}
            cmt=""
            if [[ $act == *' #'* ]]; then
                cmt=${act#*' #'}; cmt=${cmt#"${cmt%%[![:space:]]*}"}
                act=${act%%' #'*}; act=${act%"${act##*[![:space:]]}"}
            fi
            key=${combo##*+}; verb=${act%% *}; num=${act#"$verb "}
            if [[ -z $cmt && $key == [0-9] && ( $verb == workspace || $verb == move-to )
                  && -n $num && $num != *[!0-9]* ]]; then
                pre=${combo%"$key"}; num=$((10#$num))
                if (( run_n )) && [[ -z $pend && $pre == "$run_pre" && $verb == "$run_verb" ]] \
                   && (( num == run_b + 1 )); then
                    run_b=$num; run_k2=$key; (( run_n++ ))
                    continue
                fi
                flush_run
                if [[ -n $pend ]]; then
                    sub "$pend"
                    pend=""
                fi
                run_pre=$pre; run_verb=$verb; run_a=$num; run_b=$num
                run_k1=$key; run_k2=$key; run_combo=$combo; run_n=1
                continue
            fi
            flush_run
            if [[ -n $pend ]]; then
                sub "$pend"
                pend=""
            fi
            row "$combo" "$act" "${cmt:-$(act_desc "$act")}"
            ;;
    esac
done < "$HOME/.tilerc"
flush_run

# ── frame: server-level keys ────────────────────────────────────────────
hdr "FRAME   ${D}(server-level, swallowed before clients)${R}"
blank="Mod4+Escape"
while IFS= read -r line; do
    case $line in
        blank_key*)
            v=${line#*=}
            v=${v#"${v%%[![:space:]]*}"}
            [[ $v == *' #'* ]] && v=${v%%' #'*}
            v=${v%"${v##*[![:space:]]}"}
            blank=$v
            ;;
    esac
done 2>/dev/null < "$HOME/.framerc"
f="built into frame"
row "Mod4+n"             "$f" "night-light toggle (warm)"
row "Mod4+b"             "$f" "sunlight toggle (contrast)"
row "Mod4+z"             "$f" "magnifier lens toggle"
row "$blank"             "blank_key in ~/.framerc" "blank the panel now"
row "Ctrl+Alt+Backspace" "$f" "zap: end the whole session"
row "Ctrl+Alt+F1..F12"   "$f" "switch virtual terminal"

# ── glass: the Alt realm ────────────────────────────────────────────────
hdr "GLASS   ${D}(Alt realm; unbound Alt+keys pass through as Meta)${R}"
declare -A g=(
    [font_inc]=alt+plus [font_dec]=alt+minus [font_reset]=alt+underscore
    [bg_cycle]=alt+b [opacity]=alt+t [paste]=alt+v
)
if [[ -r $HOME/.glassrc ]]; then
    while IFS= read -r line; do
        case $line in
            key.*)
                kv=${line#key.}
                name=${kv%%[[:space:]=]*}
                v=${kv#*=}
                v=${v#"${v%%[![:space:]]*}"}
                v=${v%"${v##*[![:space:]]}"}
                [[ -n ${g[$name]+x} ]] && g[$name]=$v
                ;;
        esac
    done < "$HOME/.glassrc"
fi
k="in ~/.glassrc"
row "${g[font_inc]}"    "key.font_inc $k"   "font size up"
row "${g[font_dec]}"    "key.font_dec $k"   "font size down"
row "${g[font_reset]}"  "key.font_reset $k" "font size reset"
row "${g[bg_cycle]}"    "key.bg_cycle $k"   "background colour cycle"
row "${g[opacity]}"     "key.opacity $k"    "opacity cycle"
row "${g[paste]}"       "key.paste $k"      "paste PRIMARY (same as Shift+Insert)"
g="built into glass"
row "Ctrl+Shift+V"      "$g" "paste CLIPBOARD"
row "Shift+Insert"      "$g" "paste PRIMARY"
row "Shift+PgUp/PgDn"   "$g" "scrollback"
printf '\n'
